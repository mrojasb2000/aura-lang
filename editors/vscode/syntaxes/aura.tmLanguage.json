{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aura",
  "scopeName": "source.aura",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#stdlib" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.aura",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.aura",
          "match": "//.*$"
        },
        {
          "name": "comment.block.aura",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aura",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\(?:[nrt\\\\\"0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        },
        {
          "name": "string.template.aura",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\."
            },
            {
              "name": "punctuation.section.embedded.aura",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.tag.aura",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aura",
          "match": "\\b(if|else|match|when|while|for|in|break|continue|return|defer|panic|recover|select|default)\\b"
        },
        {
          "name": "keyword.declaration.aura",
          "match": "\\b(fn|let|mut|type|interface|trait|impl|module|import|export|from|extern|embed|embedBytes)\\b"
        },
        {
          "name": "keyword.concurrency.aura",
          "match": "\\b(spawn|routine|go)\\b"
        },
        {
          "name": "keyword.async.aura",
          "match": "\\b(async|await)\\b"
        },
        {
          "name": "constant.language.boolean.aura",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.aura",
          "match": "\\b(Int|Float|String|Bool|Unit|Byte|Char|Any)\\b"
        },
        {
          "name": "entity.name.type.core.aura",
          "match": "\\b(Option|Result|Task|List|Map|Set|Channel|SendChannel|RecvChannel|Context|WaitGroup|Mutex|RWMutex|Once|Pool)\\b"
        },
        {
          "name": "entity.name.type.user-defined.aura",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "stdlib": {
      "patterns": [
        {
          "name": "support.class.aura",
          "match": "\\b(pg|postgres|mysql|mongo|mongodb|redis|http|sync|json|math|io|time)\\b"
        },
        {
          "name": "support.function.builtin.aura",
          "match": "\\b(println|print|eprintln|eprint|panic|recover|len|make)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.aura",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.channel.aura",
          "match": "<-|->"
        },
        {
          "name": "keyword.operator.arrow.aura",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.aura",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.aura",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.logical.aura",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.aura",
          "match": "&|\\||\\^|<<|>>"
        },
        {
          "name": "keyword.operator.spread.aura",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.question.aura",
          "match": "\\?"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.declaration.aura" }
          }
        },
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.aura"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.aura",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.aura",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.aura",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.aura",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    }
  }
}
